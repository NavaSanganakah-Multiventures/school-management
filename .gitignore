# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/

# IDE
.vscode/
.idea/
*.iml

# Worktree copies
.kilo/

# OS files
.DS_Store
Thumbs.db

# Misc
*.log
*.pyc
*.swp

# TypeScript build info cache
*.tsbuildinfo

# Node
node_modules/

# Android keystore backups (NEVER commit)
.keystore-backup/

# Next.js static export
/out/


# Next.js build cache
/.next/

# ---------------------------------------------------------------------------
# Secrets & local state — NEVER commit (audit: HY-01)
# .env.example stays tracked so the contract remains documented.
# ---------------------------------------------------------------------------

# Real environment files
.env
.env.*
!.env.example

# Cloudflare Wrangler local state (local D1/KV/R2 databases live in here)
.wrangler/

# Local dev vars + any timestamped backups of them
.dev.vars
.dev.vars.*
*.dev.vars.bak

# Transient per-school secret files written by scripts/deploy-dedicated.mjs
wrangler-*.secrets.json
wrangler-*.secrets.json.tmp
secrets.json
secrets.local.json

# Android / signing material
*.jks
*.keystore
key.properties
*.p12
*.pfx
*.pem
*.key

# Firebase service-account / private key material (public web config is fine)
service-account*.json
*serviceAccount*.json
firebase-adminsdk*.json
*private*key*.json
