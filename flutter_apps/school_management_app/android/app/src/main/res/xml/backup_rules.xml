<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android-12 (API 30 and below) auto-backup rules.

  Android 12+ uses res/xml/data_extraction_rules.xml instead. Both exclude everything:
  the app holds student Aadhaar numbers, bank account numbers and salary figures, and a
  backup would copy all of it into a personal Google account.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>