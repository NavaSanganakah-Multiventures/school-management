# Pragnya Mitra School Management — environment values.
# Set these in GitHub Secrets; .github/workflows/deploy.yml injects them into Cloudflare Workers.

# --- Cloudflare Email Service (send_email binding, NOT a GitHub secret) ---
# Configured in wrangler.toml as [[send_email]] name = "SEND_EMAIL".
# Sending domain must be onboarded in Cloudflare Email Service dashboard:
#   navasanganakah.com  (from: pragnya@navasanganakah.com, display name: Pragnya Mitra)

# --- App base domain (password reset / invite magic links) ---
# Set in wrangler.toml [vars] as APP_BASE_URL (NOT a GitHub secret).
# Used as the base for reset/invite links: https://pragnya.nasven.com

# --- Razorpay payment gateway (test/live keys) ---
RAZORPAY_KEY_ID="rzp_test_XXXXXXXX"
RAZORPAY_KEY_SECRET="rzp_secret_XXXXXXXX"

# --- Razorpay webhook (separate from key secret; set in Razorpay dashboard) ---
# Register webhook URL: https://pragnya.nasven.com/api/webhooks/razorpay
# Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET="razp_webhook_secret_XXXXXXXX"

# --- Auth token signing secret (use a long random string) ---
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Platform Super Admin (used by POST /api/admin/bootstrap) ---
PLATFORM_ADMIN_EMAIL="admin@pragnyamitra.app"
PLATFORM_ADMIN_PASSWORD="change-me"

# --- Platform bootstrap token (REQUIRED for POST /api/admin/bootstrap) ---
# /api/admin/bootstrap overwrites the Super Admin password from env and deletes
# every other platform_admins row, and forces a PBKDF2 derivation per call. It is
# therefore gated: requests must send `X-Bootstrap-Token: <this value>`, and if
# this secret is missing the endpoint returns 503 (fails closed) rather than
# allowing unauthenticated rotation.
# Generate with: openssl rand -hex 32
# Then: gh secret set PLATFORM_BOOTSTRAP_TOKEN
PLATFORM_BOOTSTRAP_TOKEN="change-me-openssl-rand-hex-32"

# --- Internal machine-to-machine sync (/api/internal/*) ---
# Shared secret used by CI scripts and dedicated workers to call the platform's
# /api/internal/tenant-sync, /provisioning/record and /provisioning/registry.
# If unset, an independent token is derived from AUTH_SECRET.
# Generate with: openssl rand -hex 32
# Then: gh secret set INTERNAL_SYNC_SECRET
INTERNAL_SYNC_SECRET="change-me-openssl-rand-hex-32"

# Requests to /api/internal/* are additionally SIGNED (HMAC-SHA256 over
# method + path + body + timestamp, 5-minute replay window). All first-party
# callers already send signatures, so the static secret alone is not enough.
# Set the GitHub repository VARIABLE (not secret) to "true" to reject any
# unsigned internal request and close the legacy static-token path:
#   gh variable set INTERNAL_SYNC_REQUIRE_SIGNATURE --body true
# Leave unset ("false"/absent) during the transition period.
# See api/lib/internal-request-auth.ts for the rollout notes.
# INTERNAL_SYNC_REQUIRE_SIGNATURE="false"

# --- Platform base URL for scripts + worker-to-worker sync ---
# GitHub repository VARIABLE (not secret). Default: https://pragnya.nasven.com
# PLATFORM_BASE_URL="https://pragnya.nasven.com"

# --- Cloudflare deploy ---
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"

# --- Legacy applet vars (not used by the current build) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# --- Firebase Cloud Messaging (FCM) ---
# FCM_SERVICE_ACCOUNT_JSON: Google service account JSON for FCM HTTP v1 (SECRET).
# Download: Firebase Console -> Project settings -> Service accounts -> "Generate new private key".
# Store the FULL JSON (single line is fine) as the GitHub secret FCM_SERVICE_ACCOUNT_JSON.
#
# IMPORTANT: the GitHub secret value must be ONLY the raw JSON — it must start with { and
# end with }. Do NOT wrap it in single/double quotes and do NOT add the
# FCM_SERVICE_ACCOUNT_JSON= prefix. (The quotes below are only for a local .env file.)
#
# IMPORTANT: the project_id inside this JSON MUST match the Firebase project used by
# FIREBASE_WEB_CONFIG_JSON (and by the mobile apps). Current project: pragnya-mitra.
#
# The deploy workflow forwards it to the Worker as a secret (wrangler secret put).
FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"pragnya-mitra","private_key_id":"PASTE","private_key":"PASTE","client_email":"PASTE","client_id":"PASTE","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"PASTE"}'

# --- Firebase Web Config (public values, injected at build time) ---
# FIREBASE_WEB_CONFIG_JSON is stored as a GitHub Secret. The deploy workflow maps it to
# NEXT_PUBLIC_FIREBASE_WEB_CONFIG_JSON, which Next.js inlines into the client bundle at build
# time. scripts/generate-firebase-sw.js also writes public/firebase-messaging-sw.js from it.
# These values are PUBLIC at runtime (visible in the browser); they are NOT private.
#
# REQUIRED FIELDS: apiKey, authDomain, projectId, storageBucket, messagingSenderId, appId, vapidKey.
# vapidKey = Firebase Console -> Project settings -> Cloud Messaging -> Web Push certificates -> Key pair (public key).
#
# IMPORTANT: projectId MUST match FCM_SERVICE_ACCOUNT_JSON.project_id (same Firebase project).
#
# If this secret is NOT set, the build uses the committed fallback config for project "pragnya-mitra":
#   {"apiKey":"AIzaSyAsiOpqfdmFzUruBcHUWR7fLpSEtz6Jadk","authDomain":"pragnya-mitra.firebaseapp.com","projectId":"pragnya-mitra","storageBucket":"pragnya-mitra.firebasestorage.app","messagingSenderId":"450359194910","appId":"1:450359194910:web:4591b664360baa89d0c50f","vapidKey":"BJlcKjZBfC5YzmoIxZ1ndHRJAiemr7Rdi4LBuceK6GI7N6g9aV3ctHpKCtZ8RbaPugnfvfJQNBiRTi63CGipHP4"}
#
# For LOCAL development, put the same JSON in .env.local as:
#   NEXT_PUBLIC_FIREBASE_WEB_CONFIG_JSON='{"apiKey":"AIzaSyAsiOpqfdmFzUruBcHUWR7fLpSEtz6Jadk","authDomain":"pragnya-mitra.firebaseapp.com","projectId":"pragnya-mitra","storageBucket":"pragnya-mitra.firebasestorage.app","messagingSenderId":"450359194910","appId":"1:450359194910:web:4591b664360baa89d0c50f","vapidKey":"BJlcKjZBfC5YzmoIxZ1ndHRJAiemr7Rdi4LBuceK6GI7N6g9aV3ctHpKCtZ8RbaPugnfvfJQNBiRTi63CGipHP4"}'

# --- Native Web Push (browser background notifications) ---
# WEB_PUSH_VAPID_PRIVATE_KEY: the VAPID private key matching the public key above (vapidKey).
# Find it in Firebase Console -> Project settings -> Cloud Messaging -> Web Push certificates.
# The value must be base64url (URL-safe), 32 bytes. Store it as the GitHub secret WEB_PUSH_VAPID_PRIVATE_KEY.
# The deploy workflow forwards it to the Worker as a secret (wrangler secret put).
# If missing, the server falls back to FCM mobile push only; native Web Push is skipped.
WEB_PUSH_VAPID_PRIVATE_KEY="PASTE_PRIVATE_KEY_BASE64URL_32BYTES"

# =============================================================================
# Android release signing (Play Store) — for BOTH Flutter apps
# =============================================================================
# These are NOT Cloudflare KV keys and NOT web secrets — they configure APK/AAB
# signing in CI (.github/workflows/release-android.yml). They live ONLY in
# GitHub Secrets. KV (CONFIG_KV) is for server-side secrets; signing keys belong
# to the build machines (GitHub Actions) and your local machine.
#
# Keystores were generated by scripts/generate-android-keystores.ps1 and stored
# locally at (gitignored):
#   flutter_apps/super_admin_app/android/app/upload-keystore.jks
#   flutter_apps/school_management_app/android/app/upload-keystore.jks
# With a human-readable backup in .keystore-backup/keystore-secrets.txt
# (gitignored — back it up OFFLINE, e.g. a password manager).
#
# --- GitHub Secrets (already set via `gh secret set`) ---
# ADMIN_ANDROID_KEYSTORE_BASE64   base64 of the super admin upload-keystore.jks
# ADMIN_ANDROID_KEYSTORE_PASSWORD keystore password (PKCS12: same as key password)
# ADMIN_ANDROID_KEY_ALIAS         pragnya-admin
# ADMIN_ANDROID_KEY_PASSWORD      same as ADMIN_ANDROID_KEYSTORE_PASSWORD
# SCHOOL_ANDROID_KEYSTORE_BASE64  base64 of the school upload-keystore.jks
# SCHOOL_ANDROID_KEYSTORE_PASSWORD
# SCHOOL_ANDROID_KEY_ALIAS        pragnya
# SCHOOL_ANDROID_KEY_PASSWORD     same as SCHOOL_ANDROID_KEYSTORE_PASSWORD
# PLAY_SERVICE_ACCOUNT_JSON       Google Play Developer API service account JSON
#                                 (needed ONLY for CI auto-upload from
#                                 release-android.yml with publish=true)
#
# --- Local dev ---
# Each app's android/key.properties (gitignored) already contains:
#   ANDROID_KEYSTORE=upload-keystore.jks
#   ANDROID_KEYSTORE_PASSWORD=...
#   ANDROID_KEY_ALIAS=...
#   ANDROID_KEY_PASSWORD=...
# So `flutter build appbundle --release` works locally without any env vars.
#
# To create the Play API service account JSON for auto-upload:
#   1. Play Console -> Setup -> API access -> "Link or create a Google Cloud project"
#   2. "Create service account" -> name it play-deploy -> create
#   3. Grant "Repository admin" role? (see docs) then "Create JSON key" and download it
#   4. gh secret set PLAY_SERVICE_ACCOUNT_JSON < service-account.json
# The Play Console shows the service account email; add it as a licensee/tester
# if needed, then run the workflow with publish=true.
