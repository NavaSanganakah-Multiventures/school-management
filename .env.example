# VidyaSetu School Management — environment values.
# Set these in GitHub Secrets; .github/workflows/deploy.yml injects them into Cloudflare Workers.

# --- Razorpay payment gateway (test/live keys) ---
RAZORPAY_KEY_ID="rzp_test_XXXXXXXX"
RAZORPAY_KEY_SECRET="rzp_secret_XXXXXXXX"

# --- Auth token signing secret (use a long random string) ---
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Platform Super Admin (used by POST /api/admin/bootstrap) ---
PLATFORM_ADMIN_EMAIL="admin@vidyasetu.app"
PLATFORM_ADMIN_PASSWORD="change-me"

# --- Cloudflare deploy ---
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"

# --- Legacy applet vars (not used by the current build) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# --- Firebase Cloud Messaging (FCM) ---
# FCM_SERVICE_ACCOUNT_JSON: Google service account JSON for FCM HTTP v1 (SECRET).
# Download: Firebase Console -> Project settings -> Service accounts -> "Generate new private key".
# Store the FULL JSON (single line is fine) as the GitHub secret FCM_SERVICE_ACCOUNT_JSON.
# The deploy workflow forwards it to the Worker as a secret (wrangler secret put).
FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"vidyasetu-school-fcm","private_key_id":"PASTE","private_key":"PASTE","client_email":"PASTE","client_id":"PASTE","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"PASTE"}'

